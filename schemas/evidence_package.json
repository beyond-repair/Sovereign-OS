{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignOS Evidence Package",
  "type": "object",
  "required": ["action_id", "timestamp", "requestor", "authority", "evidence", "risk", "rollback"],
  "properties": {
    "action_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "requestor": { "type": "string", "enum": ["human", "agent", "system"] },
    "authority": {
      "type": "object",
      "required": ["source", "scope", "expiration"],
      "properties": {
        "source": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "expiration": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["confidence", "supporting_sources"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "supporting_sources": { "type": "array", "items": { "type": "string" } },
        "verified": { "type": "boolean" }
      }
    },
    "risk": {
      "type": "object",
      "required": ["severity", "likelihood", "impact"],
      "properties": {
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "likelihood": { "type": "number", "minimum": 0, "maximum": 1 },
        "impact": { "type": "string", "enum": ["reversible", "irreversible"] }
      }
    },
    "expected_value": {
      "type": "object",
      "properties": {
        "roi": { "type": ["number", "null"] },
        "strategic_alignment": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["available", "rollback_procedure"],
      "properties": {
        "available": { "type": "boolean" },
        "rollback_procedure": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "reviewer": { "type": ["string", "null"] }
      }
    }
  }
}
